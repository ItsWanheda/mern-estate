# ---------- APP ----------
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# ---------- DATABASE ----------
# Use a dedicated least-privilege application user; never expose MongoDB publicly.
MONGO=mongodb://app_user:change-me@127.0.0.1:27017/mern-estate?authSource=mern-estate
MONGO_MAX_POOL_SIZE=10
MONGO_MIN_POOL_SIZE=0
MONGO_SERVER_SELECTION_TIMEOUT_MS=5000
MONGO_SOCKET_TIMEOUT_MS=30000
MONGO_CONNECT_ATTEMPTS=5

# ---------- REDIS ----------
# Required in production. Optional in development (falls back to in-process rate limiting).
REDIS_URL=redis://127.0.0.1:6379

# ---------- AUTH ----------
# Production requires at least 32 random characters: openssl rand -base64 48
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# ---------- SECURITY ----------
# Number of reverse proxies in front of the app (Nginx = 1). 0 when exposed directly.
TRUST_PROXY=0
# Comma-separated explicit origins. Leave empty when the SPA is served from the same origin.
CORS_ORIGINS=
BODY_LIMIT=256kb
API_RATE_LIMIT_PER_MINUTE=300
AUTH_RATE_LIMIT_MAX=20
AUTH_RATE_LIMIT_WINDOW_MS=900000
REQUEST_TIMEOUT_MS=30000
SHUTDOWN_TIMEOUT_MS=10000

# ---------- FIREBASE ----------
# Required for Google ID-token verification and durable image storage.
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_STORAGE_BUCKET=your-project.appspot.com
# Use either these service-account values or Google Application Default Credentials.
FIREBASE_CLIENT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\\nreplace-me\\n-----END PRIVATE KEY-----\\n"
