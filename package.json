{
  "name": "mern-estate",
  "version": "1.0.0",
  "description": "Full-stack real estate marketplace built with MERN and Tailwind CSS.",
  "main": "api/server.js",
  "type": "module",
  "scripts": {
    "dev": "nodemon api/server.js",
    "start": "node api/server.js",
    "test": "node --test api/tests/*.test.js",
    "lint": "eslint -c api/eslint.config.js api",
    "check": "npm run lint",
    "build": "npm install && npm install --prefix client && npm run build --prefix client"
  },
  "keywords": [
    "real-estate",
    "mern",
    "mongodb",
    "express",
    "react",
    "tailwind"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^7.5.0",
    "multer": "^2.0.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "firebase-admin": "^13.7.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "globals": "^17.12.0",
    "nodemon": "^3.1.14",
    "pino-pretty": "^13.1.3"
  },
  "engines": {
    "node": ">=20"
  }
}
